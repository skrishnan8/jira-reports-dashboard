# Base URL for REST API calls (no trailing slash).
# For custom domains (e.g. jira.cloud.intuit.com), use the *.atlassian.net URL instead —
# scoped API tokens do not authenticate against custom-domain URLs.
JIRA_BASE_URL=https://intuit-prod.atlassian.net

# For Jira Cloud: use email + API token (Basic Auth)
# API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# For Jira Data Center/Server: use Personal Access Token (Bearer Auth)
# PAT from: Jira -> Profile picture -> Personal Access Tokens -> Create token
JIRA_PAT=

# Default label to query when the dashboard loads (can be changed in the UI too)
JIRA_DEFAULT_LABEL=V3_reports_issue2026

# Port the local dashboard server runs on
PORT=4321

# Only set to "true" if you hit self-signed certificate errors on a corporate
# network. Leave unset/false otherwise - this disables TLS verification.
JIRA_ALLOW_INSECURE_TLS=false
